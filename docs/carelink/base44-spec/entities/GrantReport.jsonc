{
  "name": "GrantReport",
  "type": "object",
  "properties": {
    "grant_id": {
      "type": "string",
      "description": "Associated grant"
    },
    "grant_name": {
      "type": "string",
      "description": "Grant name"
    },
    "funder_name": {
      "type": "string",
      "description": "Funder name"
    },
    "report_period_start": {
      "type": "string",
      "format": "date"
    },
    "report_period_end": {
      "type": "string",
      "format": "date"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "Quarterly",
        "Semi-Annual",
        "Annual"
      ],
      "description": "Type of report"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "units_of_service_count": {
      "type": "number",
      "description": "Total billable units in period"
    },
    "total_hours": {
      "type": "number",
      "description": "Total billable hours"
    },
    "metrics_data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Metric results against funder targets"
    },
    "clients_served": {
      "type": "number",
      "description": "Unduplicated client count"
    },
    "program_highlights": {
      "type": "string",
      "description": "Narrative summary of accomplishments"
    },
    "challenges_and_adaptations": {
      "type": "string",
      "description": "Barriers encountered and adjustments made"
    },
    "narrative_sections": {
      "type": "object",
      "additionalProperties": true,
      "description": "Funder-specific narrative sections"
    },
    "generated_by": {
      "type": "string",
      "description": "User who generated report"
    },
    "generated_date": {
      "type": "string",
      "format": "date"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "description": "Date submitted to funder"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready for Review",
        "Submitted",
        "Approved",
        "Archived"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "grant_id",
    "grant_name",
    "report_period_start",
    "report_period_end"
  ]
}