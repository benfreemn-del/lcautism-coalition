{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "presenter": {
      "type": "string"
    },
    "consultation_date": {
      "type": "string",
      "format": "date"
    },
    "consultation_type": {
      "type": "string",
      "enum": [
        "WA INCLUDE",
        "ECHO",
        "MDT",
        "Peer Consultation",
        "Supervisor Review",
        "Other"
      ]
    },
    "panel_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presenting_concerns": {
      "type": "string"
    },
    "background_summary": {
      "type": "string"
    },
    "panel_recommendations": {
      "type": "string"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "outcome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Completed",
        "Cancelled",
        "Follow-Up Pending"
      ],
      "default": "Scheduled"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "consultation_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.presenter": "{{user.full_name}}"
        },
        {
          "data.panel_members": "{{user.full_name}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.presenter": "{{user.full_name}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}