{
  "name": "WraparoundTeam",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "facilitator": {
      "type": "string"
    },
    "team_members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "name, role, type (natural/professional), phone, email"
    },
    "family_vision": {
      "type": "string"
    },
    "family_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "family_needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meeting_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "date, attendees, summary, action_items"
    },
    "shared_action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "task, owner, due_date, status"
    },
    "next_meeting_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Closed",
        "On Hold"
      ],
      "default": "Active"
    }
  },
  "required": [
    "client_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}