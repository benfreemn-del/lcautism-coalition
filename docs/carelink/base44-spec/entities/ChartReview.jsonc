{
  "name": "ChartReview",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "note_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "reviewee": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "Random Sample",
        "Triggered Review",
        "Quarterly Audit",
        "New Staff Review",
        "Performance Plan"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": true,
      "description": "Criterion name -> score 1-4"
    },
    "total_score": {
      "type": "number"
    },
    "max_score": {
      "type": "number"
    },
    "percentage": {
      "type": "number"
    },
    "strengths": {
      "type": "string"
    },
    "areas_for_improvement": {
      "type": "string"
    },
    "coaching_feedback": {
      "type": "string"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staff_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "staff_response": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Delivered",
        "Acknowledged",
        "Closed"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "client_name",
    "reviewer",
    "review_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.reviewer": "{{user.full_name}}"
        },
        {
          "data.reviewee": "{{user.full_name}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}