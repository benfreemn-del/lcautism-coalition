{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "sms_enabled": {
      "type": "boolean",
      "default": false
    },
    "portal_enabled": {
      "type": "boolean",
      "default": true
    },
    "email_address": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "English",
        "Spanish"
      ],
      "default": "English"
    },
    "notify_appointments": {
      "type": "boolean",
      "default": true
    },
    "notify_documents": {
      "type": "boolean",
      "default": true
    },
    "notify_messages": {
      "type": "boolean",
      "default": true
    },
    "notify_screening": {
      "type": "boolean",
      "default": true
    },
    "notify_consent": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "client_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}