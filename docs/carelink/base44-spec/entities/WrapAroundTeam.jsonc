      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "meeting_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
