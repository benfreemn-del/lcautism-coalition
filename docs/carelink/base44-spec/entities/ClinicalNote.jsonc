{
  "name": "ClinicalNote",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "Care Coordination",
        "Home Visit",
        "Phone Contact",
        "School Meeting",
        "Team Meeting",
        "Crisis Intervention",
        "Intake",
        "Discharge",
        "Follow-up",
        "Collateral Contact"
      ]
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note_body": {
      "type": "string"
    },
    "intervention": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "follow_up_plan": {
      "type": "string"
    },
    "billing_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "validation_passed": {
      "type": "boolean",
      "default": false
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_suggestions_used": {
      "type": "boolean",
      "default": false
    },
    "authored_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending Review",
        "Submitted",
        "Approved",
        "Rejected"
      ],
      "default": "Draft"
    },
    "signature_data": {
      "type": "object",
      "properties": {
        "signature_image_url": {
          "type": "string"
        },
        "signed_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "signed_by": {
          "type": "string"
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "client_name",
    "note_type",
    "session_date"
  ]
}