{
  "name": "carelink-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LCAC CareLink Phase 1 — dev API scaffold (Hono + node-postgres). DEV ONLY, no real PHI.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:load": "node db/load-schema.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/load-schema.js && node db/seed.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
