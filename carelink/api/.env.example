# LCAC CareLink API — DEV configuration (names only; NO secrets, NO real values)
# Copy to `.env` and fill in your LOCAL dev values. Never commit a real .env.
# This scaffold connects ONLY to a LOCAL Postgres you run yourself. No cloud.

# --- Local Postgres (dev only; fake seed data) ---
# Point this at a throwaway local database. Do NOT use a HIPAA/production DB.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/carelink_dev

# --- API server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Dev JWT (STUB AUTH ONLY) ---
# Local symmetric secret used to sign/verify dev login tokens.
# In the AWS target this is REPLACED by AWS Cognito (asymmetric JWKS verification).
# Generate any random string for local dev. Do NOT reuse anywhere real.
JWT_SECRET=
JWT_ISSUER=carelink-dev
JWT_EXPIRES_IN=8h
