# ============================================================================
# Email Co-Pilot — edge function secrets (EXAMPLE / template).
# ----------------------------------------------------------------------------
# Copy the names, NOT real values, into Supabase function secrets:
#   supabase secrets set LLM_API_KEY=... MONTHLY_USD_CAP=15 ...
# NEVER commit real keys. This file is only a checklist of what to set.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase at runtime — do NOT set them here.
# ============================================================================

# --- LLM (drafting) ---------------------------------------------------------
LLM_API_KEY=            # required: paid LLM key. No drafts without it.
LLM_MODEL=claude-3-5-haiku-latest
# Conservative cost-estimate rates (USD per 1M tokens) used to enforce the cap:
LLM_INPUT_USD_PER_MTOK=3
LLM_OUTPUT_USD_PER_MTOK=15

# --- HARD MONTHLY SPEND CAP (the guardrail) --------------------------------
# Drafting refuses once this month's logged spend reaches this many USD.
# Default if unset is 15. Plan suggests $10–20/mo.
MONTHLY_USD_CAP=15

# --- Inbound seam (pick ONE provider) --------------------------------------
INBOUND_PROVIDER=inbound_parse    # 'inbound_parse' (default) or 'gmail'

# If INBOUND_PROVIDER=inbound_parse (Postmark-style webhook, HTTP Basic auth):
INBOUND_PARSE_USER=
INBOUND_PARSE_PASS=

# If INBOUND_PROVIDER=gmail (Google Workspace; finish gmailInboundParser first):
GMAIL_PUSH_SECRET=

# --- Outbound send (send-approved only) ------------------------------------
EMAIL_PROVIDER_KEY=     # send-provider API key (Postmark/SendGrid/Resend/...)
EMAIL_FROM=             # e.g. executivedirector@lcautism.org
